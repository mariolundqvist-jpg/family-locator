{
  "name": "safepath-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "test:watch": "jest --watch",
    "test:device": "bash e2e/run-device-tests.sh",
    "build:android": "bash scripts/build-android.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.20",
    "expo-build-properties": "~58.0.12",
    "expo-location": "~58.0.19",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-superwall": "^1.9.0",
    "expo-task-manager": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.28.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "^30.0.0",
    "eas-cli": "^27.11.0",
    "jest": "^30.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "collectCoverageFrom": [
      "src/core/**/*.ts"
    ]
  }
}
