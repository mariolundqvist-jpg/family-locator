{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEFAULT_EMERGENCY_NUMBER": "112",
        "EXPO_PUBLIC_API_BASE": "https://safepath-server.onrender.com"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEFAULT_EMERGENCY_NUMBER": "112",
        "EXPO_PUBLIC_API_BASE": "https://safepath-server.onrender.com"
      }
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}
