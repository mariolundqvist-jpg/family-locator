{
  "expo": {
    "name": "SafePath Family Locator",
    "slug": "safepath",
    "version": "1.0.0",
    "scheme": "safepath",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#1b6e5a",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 60,
          "resizeMode": "contain",
          "backgroundColor": "#12503f"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SafePath allows voluntary background location sharing with your group when the screen is locked. A persistent indicator is shown, and sharing can be paused at any time.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "package": "app.safepath.client",
      "versionCode": 2,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "com.huawei.android.launcher.permission.CHANGE_BADGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12503f",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      }
    },
    "locales": {
      "sv": "./locales/sv.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.safepath.client",
      "buildNumber": "2",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "SafePath shares your location with your chosen group only while the app is active and only when you explicitly turn sharing on.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SafePath allows voluntary background location sharing with your group when the screen is locked. A persistent indicator is shown, and sharing can be paused at any time.",
        "NSLocationAlwaysUsageDescription": "SafePath allows voluntary background location sharing with your group when the screen is locked. Sharing can be paused at any time.",
        "NSCameraUsageDescription": "SafePath does not access the camera.",
        "NSMicrophoneUsageDescription": "SafePath does not access the microphone.",
        "NSPhotoLibraryUsageDescription": "SafePath does not access the photo library."
      },
      "dark": {
        "image": "./assets/icon-dark.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {}
  }
}
