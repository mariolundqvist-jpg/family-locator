{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/privacy", "destination": "/server/public/privacy.html" },
    { "source": "/terms", "destination": "/server/public/terms.html" },
    { "source": "/guides", "destination": "/server/public/guides.html" },
    { "source": "/(.*)", "destination": "/server/public/$1" }
  ]
}
